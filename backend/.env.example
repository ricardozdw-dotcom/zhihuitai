# 复制为 backend/.env。不填 LLM / Embedding / Rerank 密钥时，服务仍可启动：
# 元数据走文件名启发式，向量用确定性哈希，问答返回带来源的摘录。

DATABASE_URL=postgresql+psycopg://zhihuitai:zhihuitai@127.0.0.1:5432/zhihuitai
REDIS_URL=redis://127.0.0.1:6379/0
BLOB_DIR=./data/blobs
# true：API 进程内完成解析。Docker Compose 里设为 false，由 Worker 消费。
INGEST_INLINE=true
EMBEDDING_DIM=1024
CORS_ORIGINS=http://127.0.0.1:43123,http://localhost:43123

# OpenAI 兼容接口。留空表示不调用。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-plus
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
